  iconB64 = iconB64 & "oQgziirYp2Iah1TXcUj1LPatmMaUwrL39KOllLsbT35Zs4FkS2yQZafJWM7pkj0YkAabOpt5pWkTHfE+orblDCPdj1FaOaXBtSLu"
  iconB64 = iconB64 & "/iy1aYeyUiXDNU44GFqDECiliCnL/SyR+v2BWO7nKO1kMdjuHgEAthspE1d2SqwDRe9YEpn6bFspd51MpR4Qzs/YZZgZMYMUB8KU"
  iconB64 = iconB64 & "hwqoLijhsOp6ZhRXUFdcSV1JFbVFlUwuKCVoDH6pk+ebtGRedu0Ph2yKDbJs4ZKM9/AyoWzitoWlVapmiUC8Z9MLtVszdv+57d78"
  iconB64 = iconB64 & "bs3Z9/xcugvJyePOa2y3DU6aa/IGTyg79Z4DXw/9ATWmkBhSYgqDoGEQlMk5nEnYDBI2TEw53K23dEr0yaI9+ThU3BPZFhvkiOBg"
  iconB64 = iconB64 & "7ESXXH8SgglzUyUDtPs3awTcxW4x4P+JTC6IDXJIcDD+lm7vb76XV4yLZ3LoYLOBczwYUAI8NZec6DIaHrkiNsgxwYHvvRwM7Q4D"
  iconB64 = iconB64 & "161bh9aaOXPmpI757JlcEhvkoODAF53P2JBrYoMcFVwSX3g+IyEXhZYkp33AudxxPrlJrt8zOS04yP0O9MkdvHCv5LzgwBsd6ZNd"
  iconB64 = iconB64 & "vHKPeKKRA/HndT4D8YrQknjCwg3Eax3sM3548V7wnODAmx3tM7Z49R7wZKMH4g8xJxZeFVoST1q4gXj9AvgMn3y41p4/gYH41i4/"
  iconB64 = iconB64 & "yQehJfG8hRtIPl0YH4d8u6Z5dTID8a2dt8k3oSXJy5MaiC88b5GvQkuSV0PKwcj3C5hPTIRrlfcnOBDf2uUmE0FoSSbMiQ7EF15u"
  iconB64 = iconB64 & "MJGElmTCnfBAfOFlh4kotCQT9sQH4gsvM0xkoSWZ8B2wO774xhZfZLvid8YQ+MIbHb7QBsfvlGHgi294+CLbO34HpYkvvl3xRZYe"
  iconB64 = iconB64 & "fmeNgokqPl9kI8fvuDEkXwXoC2zs8DtyHPGqAH2BjR9+x2aYXBOhL67M4nd2jjHWgvQFlVv8f+qxIM3E9nY1AAAAAElFTkSuQmCC"
  Dim fi : Set fi = FSO.CreateTextFile(iconPng & ".b64", True, False)
  fi.Write iconB64 : fi.Close
  document.getElementById("pmsg").innerText = "Creation de l icone..."
  document.getElementById("pfl").style.width = "50%"
  If FSO.FileExists(IcoFile) Then FSO.DeleteFile IcoFile
  Dim fp : Set fp = FSO.CreateTextFile(psFile, True, False)
  fp.WriteLine "Add-Type -AssemblyName System.Drawing"
  fp.WriteLine "Add-Type -AssemblyName System.Drawing.Drawing2D"
  fp.WriteLine "$raw=[System.IO.File]::ReadAllText('" & iconPng & ".b64')"
  fp.WriteLine "$bytes=[System.Convert]::FromBase64String($raw)"
  fp.WriteLine "[System.IO.File]::WriteAllBytes('" & iconPng & "',$bytes)"
  fp.WriteLine "$src=[System.Drawing.Bitmap]::FromFile('" & iconPng & "')"
  fp.WriteLine "$full=256;$pad=13;$sz=$full-$pad*2;$arc=43"
  fp.WriteLine "$bmp=New-Object System.Drawing.Bitmap($full,$full)"
  fp.WriteLine "$g=[System.Drawing.Graphics]::FromImage($bmp)"
  fp.WriteLine "$g.Clear([System.Drawing.Color]::Transparent)"
  fp.WriteLine "$g.SmoothingMode=2;$g.InterpolationMode=7"
  fp.WriteLine "$path=New-Object System.Drawing.Drawing2D.GraphicsPath"
  fp.WriteLine "$path.AddArc(0,0,$arc,$arc,180,90)"
  fp.WriteLine "$path.AddArc($full-$arc,0,$arc,$arc,270,90)"
  fp.WriteLine "$path.AddArc($full-$arc,$full-$arc,$arc,$arc,0,90)"
  fp.WriteLine "$path.AddArc(0,$full-$arc,$arc,$arc,90,90)"
  fp.WriteLine "$path.CloseFigure()"
  fp.WriteLine "$brush=New-Object System.Drawing.SolidBrush([System.Drawing.Color]::White)"
  fp.WriteLine "$g.FillPath($brush,$path)"
  fp.WriteLine "$g.DrawImage($src,$pad,$pad,$sz,$sz)"
  fp.WriteLine "$g.Dispose();$brush.Dispose();$path.Dispose();$src.Dispose()"
  fp.WriteLine "$ic=[System.Drawing.Icon]::FromHandle($bmp.GetHicon())"
  fp.WriteLine "$s=New-Object System.IO.FileStream('" & IcoFile & "',[System.IO.FileMode]::Create)"
  fp.WriteLine "$ic.Save($s);$s.Close();$ic.Dispose();$bmp.Dispose()"
  fp.WriteLine "Remove-Item '" & iconPng & "' -Force -ErrorAction SilentlyContinue"
  fp.WriteLine "Remove-Item '" & iconPng & ".b64' -Force -ErrorAction SilentlyContinue"
  fp.Close
  WS.Run "powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File """ & psFile & """", 0, True
  If FSO.FileExists(psFile) Then FSO.DeleteFile psFile
  document.getElementById("pmsg").innerText = "Creation du raccourci..."
  document.getElementById("pfl").style.width = "80%"
  If FSO.FileExists(LnkFile) Then FSO.DeleteFile LnkFile
  Dim Lnk : Set Lnk = WS.CreateShortcut(LnkFile)
  Lnk.TargetPath       = "https://diafagestion.github.io/diafagestion"
  Lnk.IconLocation     = IcoFile & ",0"
  Lnk.Description      = "DiafaGestion - Gestion Financiere Personnelle"
  Lnk.WorkingDirectory = AppFolder
  Lnk.Save
  document.getElementById("pfl").style.width = "100%"
  document.getElementById("pb").style.display = "none"
  document.getElementById("statusBox").className = "sok"
  document.getElementById("statusBox").innerText = "Installation reussie ! Icone DiafaGestion creee sur le Bureau."
  document.getElementById("statusBox").style.display = "block"
  document.getElementById("btnI").disabled = False
  Err.Clear
End Sub

Sub doLaunch()
  Dim oShell : Set oShell = CreateObject("WScript.Shell")
  oShell.Run "https://diafagestion.github.io/diafagestion", 1, False
End Sub
</script>
</body>
</html>