<html>
<head>
<title>DiafaGestion Installation</title>
<HTA:APPLICATION
  ID="DiafaGestion"
  APPLICATIONNAME="DiafaGestion"
  BORDER="thin"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  VERSION="1.0"
  SCROLL="no"
  WINDOWWIDTH="900"
  WINDOWHEIGHT="600"
/>
<meta charset="UTF-8">
<style>
*{margin:0;padding:0;}
html,body{font-family:Arial,sans-serif;background:#e8eaf2;overflow:hidden;margin:0;padding:0;}
#logoImg{width:120px;height:120px;border:3px solid #fff;border-radius:20px;background:#fff;padding:6px;display:block;margin:0 auto 16px auto;}
#appName{font-size:46px;font-weight:800;color:#fff;display:block;margin-bottom:8px;}
#appGreen{color:#4ade80;}
#appSub{font-size:19px;color:#fca5a5;letter-spacing:2px;text-transform:uppercase;display:block;margin-bottom:16px;}
#vBadge{background:#fff;color:#dc2626;font-size:19px;font-weight:800;padding:7px 24px;border-radius:99px;display:inline-block;}

#rHead{border-bottom:1px solid #f3f4f6;padding-bottom:16px;margin-bottom:18px;}
#rTitle{font-size:30px;font-weight:800;color:#1a1d2e;margin-bottom:10px;}
#rDesc{font-size:20px;color:#6b7280;line-height:1.6;}
#statusBox{display:none;padding:12px 16px;border-radius:9px;font-size:18px;margin-bottom:12px;}
.sok{background:#dcfce7;color:#15803d;border:1px solid #86efac;}
.serr{background:#fee2e2;color:#dc2626;border:1px solid #fca5a5;}
#pb{display:none;margin-bottom:12px;background:#f8fafc;border-radius:8px;padding:12px 16px;}
#pmsg{font-size:16px;color:#6b7280;margin-bottom:8px;}
#pbg{height:16px;background:#e5e7eb;border-radius:8px;overflow:hidden;}
#pfl{height:16px;width:0%;background:#dc2626;border-radius:8px;transition:width 0.4s;}
#btnI{display:block;width:100%;padding:18px;background:#dc2626;color:#fff;border:none;border-radius:12px;font-size:20px;font-weight:800;cursor:pointer;margin-bottom:12px;font-family:Arial;}
#btnL{display:block;width:100%;padding:18px;background:#f0fdf4;color:#15803d;border:2px solid #86efac;border-radius:12px;font-size:20px;font-weight:800;cursor:pointer;margin-bottom:16px;font-family:Arial;}
#conseil{background:#f8fafc;border-radius:8px;padding:12px 16px;border-left:4px solid #dc2626;font-size:17px;color:#374151;line-height:1.7;margin-bottom:14px;}
#footer{text-align:center;border-top:1px solid #f3f4f6;padding-top:12px;font-size:16px;color:#9ca3af;font-weight:600;}
</style>
</head>
<body>
<table width="100%" height="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td id="left" width="38%" bgcolor="#dc2626" align="center" valign="middle" style="border-right:4px solid #b91c1c;padding:30px 18px;">
  <img id="logoImg" src="data:image/png;base64," alt="">
  <span id="appName">Diafa<span id="appGreen">Gestion</span></span>
  <span id="appSub">DIAFA Consulting</span>
  <span id="vBadge">v1.0</span>
</td>
<td id="right" width="62%" bgcolor="#ffffff" valign="top" style="padding:32px 34px 20px;">
  <div id="rHead">
    <div id="rTitle">Bienvenue sur DiafaGestion</div>
    <div id="rDesc">Solution complete de gestion financiere personnelle par <strong style="color:#dc2626;">DIAFA Consulting</strong>. Suivez vos revenus, depenses et objectifs facilement.</div>
  </div>
  <div id="statusBox"></div>
  <div id="pb"><div id="pmsg"></div><div id="pbg"><div id="pfl"></div></div></div>
  <button id="btnI" onclick="doInstall()">Installer DiafaGestion</button>
  <button id="btnL" onclick="doLaunch()">Lancer DiafaGestion</button>
  <div id="conseil"><strong>Conseil :</strong> Commencez par Installer pour retrouver DiafaGestion sur votre Bureau.</div>
  <div id="footer">2025 DIAFA Consulting - Tous droits reserves</div></td>
</tr></table>
</div>

<script language="VBScript">
Sub Window_OnLoad()
  window.resizeTo 900, 600
  window.moveTo (screen.width - 900) \ 2, (screen.height - 600) \ 2
End Sub

Sub doInstall()
  On Error Resume Next
  document.getElementById("btnI").disabled = True
  document.getElementById("statusBox").style.display = "none"
  document.getElementById("pb").style.display = "block"
  document.getElementById("pmsg").innerText = "Preparation..."
  document.getElementById("pfl").style.width = "10%"
  Dim FSO, WS, AppFolder, IcoFile, iconPng, LnkFile, psFile
  Set FSO = CreateObject("Scripting.FileSystemObject")
  Set WS  = CreateObject("WScript.Shell")
  AppFolder = WS.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\DiafaGestion"
  IcoFile   = AppFolder & "\DiafaGestion.ico"
  iconPng   = AppFolder & "\icon.png"
  psFile    = AppFolder & "\mkico.ps1"
  LnkFile   = WS.SpecialFolders("Desktop") & "\DiafaGestion.lnk"
